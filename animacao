<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Animação hidrodinâmica — Barreira de Bolhas</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #373737;
      color: #fff;
      font: 16px system-ui, sans-serif;
    }
    main { width: min(1100px, 96vw); }
    h1 { font-size: 1.3rem; }
    #quadro {
      display: block;
      width: 100%;
      max-height: 72vh;
      object-fit: contain;
      background: #5e5b59;
    }
    .controles {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 12px;
    }
    button, select {
      padding: 8px 12px;
      border: 1px solid #4fc3f7;
      border-radius: 6px;
      background: #0b2b40;
      color: white;
      font: inherit;
      cursor: pointer;
    }
    input[type="range"] { flex: 1; min-width: 150px; }
    #mensagem { margin-top: 12px; }
  </style>
</head>
<body>
  <main>
    <h1>Simulação hidrodinâmica — Barreira de Bolhas</h1>
    <img id="quadro" alt="Quadro da simulação" hidden>
    <div id="mensagem" role="status">Verificando os quadros enviados…</div>

    <div class="controles">
      <button id="reproduzir" type="button" disabled>▶ Reproduzir</button>
      <input id="posicao" type="range" min="0" max="0" value="0"
             aria-label="Selecionar quadro" disabled>
      <label for="velocidade">Velocidade</label>
      <select id="velocidade" disabled>
        <option value="200">5 quadros/s</option>
        <option value="100" selected>10 quadros/s</option>
        <option value="50">20 quadros/s</option>
      </select>
      <span id="contador"></span>
    </div>
  </main>

  <script>
    const imagem = document.getElementById('quadro');
    const mensagem = document.getElementById('mensagem');
    const botao = document.getElementById('reproduzir');
    const posicao = document.getElementById('posicao');
    const velocidade = document.getElementById('velocidade');
    const contador = document.getElementById('contador');

    let quadros = [];
    let atual = 0;
    let temporizador = null;

    function caminho(numero) {
      return `./simulacao.${String(numero).padStart(4, '0')}.png`;
    }

    // Detecta a sequência a partir de 0000 e para no primeiro arquivo ausente.
    function procurarQuadro(numero) {
      const teste = new Image();
      teste.onload = () => {
        quadros.push(caminho(numero));
        procurarQuadro(numero + 1);
      };
      teste.onerror = () => iniciar();
      teste.src = caminho(numero);
    }

    function mostrar(numero) {
      atual = numero;
      imagem.src = quadros[atual];
      posicao.value = atual;
      contador.textContent = `Quadro ${atual + 1} / ${quadros.length}`;
    }

    function iniciar() {
      if (quadros.length === 0) {
        mensagem.textContent =
          'Não encontrei simulacao.0000.png na raiz. Confira os nomes e se os arquivos foram enviados.';
        return;
      }

      mensagem.hidden = true;
      imagem.hidden = false;
      posicao.max = quadros.length - 1;
      botao.disabled = false;
      posicao.disabled = false;
      velocidade.disabled = false;
      mostrar(0);
    }

    function parar() {
      clearInterval(temporizador);
      temporizador = null;
      botao.textContent = '▶ Reproduzir';
    }

    botao.addEventListener('click', () => {
      if (temporizador) {
        parar();
        return;
      }
      botao.textContent = '❚❚ Pausar';
      temporizador = setInterval(() => {
        mostrar((atual + 1) % quadros.length);
      }, Number(velocidade.value));
    });

    posicao.addEventListener('input', () => mostrar(Number(posicao.value)));

    velocidade.addEventListener('change', () => {
      if (temporizador) {
        parar();
        botao.click();
      }
    });

    procurarQuadro(0);
  </script>
</body>
</html>
